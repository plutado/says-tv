# Optional environment overrides. Copy to .env and edit; .env is git-ignored.
# says does not read .env by itself; load it with your shell or a tool such as direnv.

# Path to the config file (default: ./says.toml)
SAYS_CONFIG=./says.toml

# Override settings.database
SAYS_DATABASE=./data/says.db

# Override settings.audio_cache
SAYS_AUDIO_CACHE=./data/audio

# Override settings.transcriber: none | faster-whisper
SAYS_TRANSCRIBER=none
